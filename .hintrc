{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "backdrop-filter"
        ]
      }
    ],
    "axe/name-role-value": [
      "default",
      {
        "button-name": "off"
      }
    ],
    "axe/forms": "off",
    "axe/aria": "off",
    "no-inline-styles": "off",
    "typescript-config/consistent-casing": "off",
    "meta-viewport": "off",
    "axe/text-alternatives": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not ios_saf <= 15.8",
    "not and_chr <= 121",
    "not and_ff <= 122",
    "not chrome <= 122",
    "not edge <= 121",
    "not firefox <= 123",
    "not ios_saf <= 17.3",
    "not opera <= 106",
    "not safari <= 17.3",
    "not samsung <= 23"
  ]
}